# =============================================================================
# PersDocBench — environment template
# Copy to .env (git-ignored) and fill in. Never commit a real .env.
# =============================================================================

# --- Content generation (Stage C) -------------------------------------------
# OpenAI-compatible endpoint. Multiple keys may be supplied as a comma-separated
# list; each key gets its own rate-limit bucket because provider limits are
# per key, not global.
#
#   NVIDIA_API_KEY=nv_key1,nv_key2,nv_key3
#
# Keys are never written to logs, ledgers or run manifests — only sha256[:8]
# fingerprints appear there. Check the provider's terms before aggregating
# several free-tier keys; one key sustained at the documented rate needs about
# 100 minutes for 6,000 requests.
NVIDIA_API_KEY=
# NVIDIA_API_KEY_1=...
# NVIDIA_API_KEY_2=...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_REQUESTS_PER_MINUTE=60

# --- Research / literature (Gate 1) -----------------------------------------
# Required for Semantic Scholar / Google Scholar / citation-network queries.
AI4SCHOLAR_API_KEY=

# --- Hugging Face (dataset publication, model hosting) ----------------------
HF_TOKEN=

# --- Experiment tracking ----------------------------------------------------
MLFLOW_TRACKING_URI=file:./experiments/mlruns

# --- Local paths (optional overrides) ---------------------------------------
# PERSDOCBENCH_DATA_ROOT=./data
# PERSDOCBENCH_CACHE_DIR=./.cache
