{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/shahriar-hd/persdocbench/main/schemas/page-metadata.schema.json",
  "title": "PersDocBench Page Metadata",
  "type": "object",
  "required": [
    "document_id",
    "page_id",
    "image_path",
    "language",
    "document_type",
    "content_origin",
    "capture_method",
    "width_px",
    "height_px"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "page_id": {
      "type": "string"
    },
    "image_path": {
      "type": "string"
    },
    "source_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": "array",
      "items": {
        "enum": [
          "fa",
          "ar",
          "en",
          "mixed",
          "other"
        ]
      }
    },
    "script": {
      "type": "string"
    },
    "document_type": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "subdomain": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_origin": {
      "enum": [
        "real_source",
        "nvidia_generated",
        "human_authored",
        "other"
      ]
    },
    "page_render_origin": {
      "enum": [
        "native_pdf_render",
        "synthetic_composition",
        "other"
      ]
    },
    "capture_method": {
      "enum": [
        "born_digital_render",
        "simulated_scanner",
        "simulated_camera",
        "physical_scanner",
        "phone_camera"
      ]
    },
    "width_px": {
      "type": "integer",
      "minimum": 1
    },
    "height_px": {
      "type": "integer",
      "minimum": 1
    },
    "dpi_x": {
      "type": [
        "number",
        "null"
      ]
    },
    "dpi_y": {
      "type": [
        "number",
        "null"
      ]
    },
    "color_mode": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "sha256": {
      "type": "string"
    },
    "perceptual_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "font_families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "layout_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard",
        "very_hard",
        "expert"
      ]
    },
    "augmentation_profile_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
